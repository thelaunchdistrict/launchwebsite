# Public site URL (used for canonical URLs, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://falcon.example.com

# Analytics — off unless set
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Lead capture
# LEAD_STORE=file   → append to .leads/leads.jsonl (local/dev; ignored on Vercel)
# LEAD_STORE=webhook → POST JSON to LEAD_WEBHOOK_URL (Zapier, Make, Google Apps Script → Sheet, CRM)
LEAD_STORE=file
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
